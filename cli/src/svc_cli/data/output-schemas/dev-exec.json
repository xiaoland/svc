{
  "$defs": {
    "CliUsageOutput": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "invalid-cli-usage",
          "default": "invalid-cli-usage",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "CliUsageOutput",
      "type": "object"
    },
    "JsonValue": {},
    "MachineError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/MachineErrorBody"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "error"
      ],
      "title": "MachineError",
      "type": "object"
    },
    "MachineErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "MachineErrorBody",
      "type": "object"
    },
    "ManagedOutput": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "dev exec",
          "default": "dev exec",
          "title": "Command",
          "type": "string"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "group_state": {
          "title": "Group State",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "logs": {
          "items": {
            "type": "string"
          },
          "title": "Logs",
          "type": "array"
        },
        "retry_allowed": {
          "anyOf": [
            {
              "const": false,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retry Allowed"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "state": {
          "enum": [
            "starting",
            "running",
            "exited",
            "interrupted",
            "start-failed",
            "capture-failed",
            "owner-lost",
            "released"
          ],
          "title": "State",
          "type": "string"
        },
        "stopped_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stopped By"
        }
      },
      "required": [
        "execution_id",
        "label",
        "source",
        "state",
        "exit_code",
        "stopped_by",
        "group_state",
        "logs",
        "retry_allowed"
      ],
      "title": "ManagedOutput",
      "type": "object"
    }
  },
  "$id": "urn:svc:cli-output:dev-exec:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ManagedOutput"
    },
    {
      "$ref": "#/$defs/MachineError"
    },
    {
      "$ref": "#/$defs/CliUsageOutput"
    }
  ],
  "title": "SVC dev-exec machine output",
  "x-svc-result-schema-version": 1
}
