{
  "$defs": {
    "CliUsageOutput": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "invalid-cli-usage",
          "default": "invalid-cli-usage",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "CliUsageOutput",
      "type": "object"
    },
    "ExecutionLogsOutput": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "dev logs",
          "default": "dev logs",
          "title": "Command",
          "type": "string"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "execution_id",
        "text",
        "truncated"
      ],
      "title": "ExecutionLogsOutput",
      "type": "object"
    },
    "JsonValue": {},
    "MachineError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/MachineErrorBody"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "error"
      ],
      "title": "MachineError",
      "type": "object"
    },
    "MachineErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "MachineErrorBody",
      "type": "object"
    }
  },
  "$id": "urn:svc:cli-output:dev-logs:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ExecutionLogsOutput"
    },
    {
      "$ref": "#/$defs/MachineError"
    },
    {
      "$ref": "#/$defs/CliUsageOutput"
    }
  ],
  "title": "SVC dev-logs machine output",
  "x-svc-result-schema-version": 1
}
