{
  "$defs": {
    "CliUsageOutput": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "invalid-cli-usage",
          "default": "invalid-cli-usage",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "CliUsageOutput",
      "type": "object"
    },
    "Coordination": {
      "additionalProperties": false,
      "properties": {
        "coordination_id": {
          "title": "Coordination Id",
          "type": "string"
        },
        "owner_repo": {
          "title": "Owner Repo",
          "type": "string"
        },
        "owner_resource": {
          "title": "Owner Resource",
          "type": "string"
        },
        "scope": {
          "enum": [
            "worktree",
            "repository",
            "host"
          ],
          "title": "Scope",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "workspace_instance": {
          "title": "Workspace Instance",
          "type": "string"
        }
      },
      "required": [
        "coordination_id",
        "scope",
        "scope_id",
        "workspace_instance",
        "owner_repo",
        "owner_resource"
      ],
      "title": "Coordination",
      "type": "object"
    },
    "DevActOutput": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "command": {
          "const": "dev act",
          "default": "dev act",
          "title": "Command",
          "type": "string"
        },
        "coordination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordination"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaration_digest": {
          "title": "Declaration Digest",
          "type": "string"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "joined": {
          "default": false,
          "title": "Joined",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Signal"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "ready",
            "accepted",
            "reused",
            "busy",
            "manual",
            "absent",
            "stale",
            "condition-unmet",
            "owner-lost",
            "failed",
            "interrupted",
            "acknowledged",
            "nothing-to-reconcile"
          ],
          "title": "Status",
          "type": "string"
        },
        "steps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "resource",
        "entry_id",
        "action",
        "declaration_digest",
        "coordination",
        "status",
        "message"
      ],
      "title": "DevActOutput",
      "type": "object"
    },
    "ExecutionView": {
      "additionalProperties": false,
      "properties": {
        "acknowledged": {
          "default": false,
          "title": "Acknowledged",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "log_path": {
          "title": "Log Path",
          "type": "string"
        },
        "phase": {
          "enum": [
            "pending",
            "settled",
            "owner-lost"
          ],
          "title": "Phase",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "state",
        "phase",
        "log_path"
      ],
      "title": "ExecutionView",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "An immutable snapshot when a failure is part of a larger service result.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "Failure",
      "type": "object"
    },
    "JsonValue": {},
    "MachineError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/MachineErrorBody"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "error"
      ],
      "title": "MachineError",
      "type": "object"
    },
    "MachineErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "MachineErrorBody",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "data_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data At"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "instance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "satisfied",
            "unsatisfied",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "key",
        "label",
        "state",
        "source",
        "checked_at"
      ],
      "title": "Observation",
      "type": "object"
    },
    "OperationReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id"
      ],
      "title": "OperationReference",
      "type": "object"
    }
  },
  "$id": "urn:svc:cli-output:dev-act:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DevActOutput"
    },
    {
      "$ref": "#/$defs/MachineError"
    },
    {
      "$ref": "#/$defs/CliUsageOutput"
    }
  ],
  "title": "SVC dev-act machine output",
  "x-svc-result-schema-version": 1
}
