{
  "$defs": {
    "ActionDescription": {
      "additionalProperties": false,
      "properties": {
        "completion": {
          "anyOf": [
            {
              "enum": [
                "exit",
                "ready",
                "submitted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion"
        },
        "convergent": {
          "default": false,
          "title": "Convergent",
          "type": "boolean"
        },
        "data_effect": {
          "enum": [
            "unchanged",
            "modify",
            "delete",
            "unknown"
          ],
          "title": "Data Effect",
          "type": "string"
        },
        "effect_scope": {
          "title": "Effect Scope",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "interruption": {
          "anyOf": [
            {
              "enum": [
                "wait",
                "terminate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interruption"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "manual",
            "exec"
          ],
          "title": "Kind",
          "type": "string"
        },
        "steps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "traits": {
          "items": {
            "enum": [
              "observe",
              "runtime",
              "provision",
              "connection",
              "installation"
            ],
            "type": "string"
          },
          "title": "Traits",
          "type": "array"
        }
      },
      "required": [
        "key",
        "kind",
        "intent",
        "traits",
        "effect_scope",
        "data_effect"
      ],
      "title": "ActionDescription",
      "type": "object"
    },
    "CliUsageOutput": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "invalid-cli-usage",
          "default": "invalid-cli-usage",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "CliUsageOutput",
      "type": "object"
    },
    "Coordination": {
      "additionalProperties": false,
      "properties": {
        "coordination_id": {
          "title": "Coordination Id",
          "type": "string"
        },
        "owner_repo": {
          "title": "Owner Repo",
          "type": "string"
        },
        "owner_resource": {
          "title": "Owner Resource",
          "type": "string"
        },
        "scope": {
          "enum": [
            "worktree",
            "repository",
            "host"
          ],
          "title": "Scope",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "workspace_instance": {
          "title": "Workspace Instance",
          "type": "string"
        }
      },
      "required": [
        "coordination_id",
        "scope",
        "scope_id",
        "workspace_instance",
        "owner_repo",
        "owner_resource"
      ],
      "title": "Coordination",
      "type": "object"
    },
    "DevStatusOutput": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "dev status",
          "default": "dev status",
          "title": "Command",
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceView"
          },
          "title": "Resources",
          "type": "array"
        },
        "schema_version": {
          "const": 4,
          "default": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "not-configured"
          ],
          "title": "Status",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceIdentity"
        }
      },
      "required": [
        "workspace",
        "status",
        "resources"
      ],
      "title": "DevStatusOutput",
      "type": "object"
    },
    "ExecutionView": {
      "additionalProperties": false,
      "properties": {
        "acknowledged": {
          "default": false,
          "title": "Acknowledged",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "log_path": {
          "title": "Log Path",
          "type": "string"
        },
        "phase": {
          "enum": [
            "pending",
            "settled",
            "owner-lost"
          ],
          "title": "Phase",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "state",
        "phase",
        "log_path"
      ],
      "title": "ExecutionView",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "An immutable snapshot when a failure is part of a larger service result.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "Failure",
      "type": "object"
    },
    "JsonValue": {},
